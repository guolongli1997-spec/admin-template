{
"$schema": "https://json.schemastore.org/wagner",
"project": {
"name": "admin-template",
"structure": "app-router",
"root": "src"
},
"directories": {
"app": "src/app",
"auth": "src/app/auth",
"dashboard": "src/app/dashboard",
"components": "src/components",
"config": "src/config",
"hooks": "src/hooks",
"lib": "src/lib",
"navigation": "src/navigation"
},
"files": {
"middleware": "src/middleware.ts",
"config": "wregner.jsonc"
},
"routing": {
"login": {
"path": "/auth/login",
"entry": "src/app/auth/login/page.tsx",
"components": "src/app/auth/login/_components/"
},
"register": {
"path": "/auth/register",
"entry": "src/app/auth/register/page.tsx",
"components": "src/app/auth/register/_components/"
},
"dashboard": {
"path": "/dashboard",
"entry": "src/app/dashboard/page.tsx",
"layout": "src/app/dashboard/layout.tsx",
"components": "src/app/dashboard/_components/"
}
}
}